{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}\\VMPlex.sln"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}\\VMPlex.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run VMPlex",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}\\VMPlex\\VMPlex.csproj"
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        }
    ]
}
